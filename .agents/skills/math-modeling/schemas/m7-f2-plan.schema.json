{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/math-modeling/m7-f2-plan.schema.json",
  "title": "M7 precheck and F2 official submission plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_report", "support_smoke_report", "required_smoke_tests", "official_upload", "human_gate"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "package_report": {"type": "string", "minLength": 1},
    "support_smoke_report": {"type": "string", "minLength": 1},
    "required_smoke_tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "official_upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competition", "platform", "receipt", "allowed_receipt_suffixes"],
      "properties": {
        "competition": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "minLength": 1},
        "allowed_receipt_suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m7_manifest", "f2_manifest"],
      "properties": {
        "m7_manifest": {"type": "string", "minLength": 1},
        "f2_manifest": {"type": "string", "minLength": 1}
      }
    }
  }
}
