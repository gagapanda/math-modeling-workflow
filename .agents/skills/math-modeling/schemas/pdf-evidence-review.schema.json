{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/math-modeling/pdf-evidence-review.schema.json",
  "title": "Human review of selected PDF evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "manifest_sha256", "reviewer", "reviewed_at", "pages", "formulas", "insights"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "pages": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pageReview"}},
    "formulas": {"type": "array", "items": {"$ref": "#/$defs/formulaReview"}},
    "insights": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/insight"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pageReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "image_sha256", "visual_confirmed", "ocr_backend", "ocr_text", "notes"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "visual_confirmed": {"const": true},
        "ocr_backend": {"enum": ["matlab_ocr", "native_text", "manual_transcription", "other"]},
        "ocr_text": {"type": "string"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "formulaReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "page", "status", "ocr_transcription", "verified_transcription", "visual_location", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "page": {"type": "integer", "minimum": 1},
        "status": {"enum": ["verified", "rejected"]},
        "ocr_transcription": {"type": "string"},
        "verified_transcription": {"type": "string"},
        "visual_location": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "page", "category", "claim", "decision", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "page": {"type": "integer", "minimum": 1},
        "category": {"enum": ["structure", "model", "validation", "presentation", "data", "compliance"]},
        "claim": {"type": "string", "minLength": 1},
        "decision": {"enum": ["adopt", "reference", "reject"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
