{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/math-modeling/support-smoke-plan.schema.json",
  "title": "Support package smoke plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "tests"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "package": {"type": "string", "minLength": 1},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/test"}
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "cwd", "expected_outputs", "timeout_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "expected_outputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  }
}
