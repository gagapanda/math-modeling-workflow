{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/math-modeling/m6-compliance-plan.schema.json",
  "title": "Complete M6 compliance plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "legacy_submission_compliance",
    "official_rules",
    "anonymity",
    "sources",
    "ai",
    "human_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "legacy_submission_compliance": {
      "type": "string",
      "minLength": 1
    },
    "official_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "snapshot_sha256",
        "verified_at",
        "max_age_days",
        "sources",
        "impact_steps"
      ],
      "properties": {
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^/\\s]+(?:/.*)?$"
          }
        },
        "impact_steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "anonymity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_package_plan",
        "allowed_anonymous_values",
        "forbidden_path_patterns"
      ],
      "properties": {
        "submission_package_plan": {
          "type": "string",
          "minLength": 1
        },
        "allowed_anonymous_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden_path_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register"
      ],
      "properties": {
        "register": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_log_required_markers",
        "detail_pdf_required_markers"
      ],
      "properties": {
        "usage_log_required_markers": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detail_pdf_required_markers": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
