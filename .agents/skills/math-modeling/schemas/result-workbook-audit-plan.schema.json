{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/math-modeling/result-workbook-audit-plan.schema.json",
  "title": "Result workbook audit plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workbook", "workbook_sha256", "required_sheets", "required_cells"],
  "properties": {
    "schema_version": {"const": 1},
    "workbook": {"$ref": "#/$defs/relativePath"},
    "workbook_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_register": {"$ref": "#/$defs/relativePath"},
    "required_sheets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbid_extra_sheets": {"type": "boolean"},
    "required_cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cellCheck"}
    },
    "registered_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/resultCheck"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "cellAddress": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"
    },
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "cellCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sheet", "cell"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "sheet": {"type": "string", "minLength": 1},
        "cell": {"$ref": "#/$defs/cellAddress"},
        "expected": {"$ref": "#/$defs/scalar"},
        "expected_type": {"enum": ["number", "string", "boolean"]},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "required_number_format": {"type": "string", "minLength": 1},
        "allow_formula": {"type": "boolean"},
        "allow_blank": {"type": "boolean"}
      }
    },
    "resultCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "sheet", "cell"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "cell": {"$ref": "#/$defs/cellAddress"},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0}
      }
    }
  }
}
