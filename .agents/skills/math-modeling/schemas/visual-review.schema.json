{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/math-modeling/visual-review.schema.json",
  "title": "Recorded visual review evidence (not human acceptance)",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reviewed_at",
    "reviewer",
    "pdf_sha256",
    "page_count",
    "reviewed_pages",
    "rendered_pages_sha256",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "const": "passed"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "rendered_pages_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "notes": {
      "type": "string"
    },
    "inspection_scope": {
      "enum": [
        "all_pages",
        "contact_sheet_only",
        "thumbnail_only",
        "sample_only"
      ]
    }
  }
}
