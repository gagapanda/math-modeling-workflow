{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/math-modeling/result-freeze-manifest.schema.json",
  "title": "F1 result-freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "freeze_id", "status", "paper_authoritative", "generated_at", "source_plan", "source_candidate", "result_register", "replay_evidence", "limitations", "unresolved", "files", "human_decision"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "freeze_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["F1_PENDING_HUMAN", "F1_ACCEPTED", "F1_ACCEPTED_WITH_LIMITATIONS", "F1_REJECTED"]},
    "paper_authoritative": {"type": "boolean"},
    "generated_at": {"type": "string", "minLength": 1},
    "source_plan": {"$ref": "#/$defs/binding"},
    "source_candidate": {"$ref": "#/$defs/optional_binding"},
    "result_register": {"$ref": "#/$defs/binding"},
    "replay_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "human_decision": {"$ref": "#/$defs/human_decision"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "optional_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewer", "review_start", "review_end", "signed_at", "objections", "resolution", "confirmation"],
      "properties": {
        "decision": {"type": "string", "enum": ["not_reviewed", "accepted", "accepted_with_limitations", "rejected"]},
        "reviewer": {"type": "string"},
        "review_start": {"type": "string"},
        "review_end": {"type": "string"},
        "signed_at": {"type": "string"},
        "objections": {"type": "string"},
        "resolution": {"type": "string"},
        "confirmation": {"type": "string", "enum": ["NOT_CONFIRMED", "I_REVIEWED_THE_LISTED_EVIDENCE"]}
      }
    }
  }
}
