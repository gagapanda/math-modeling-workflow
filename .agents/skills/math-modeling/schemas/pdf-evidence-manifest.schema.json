{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/math-modeling/pdf-evidence-manifest.schema.json",
  "title": "Selected PDF evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "plan_sha256", "source", "purpose", "dpi", "renderer", "pages", "source_unchanged", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "prepared"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "label", "provenance", "page_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "label": {"type": "string", "minLength": 1},
        "provenance": {"type": "object"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "dpi": {"type": "integer", "minimum": 120, "maximum": 400},
    "renderer": {"type": "string", "minLength": 1},
    "pages": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/page"}},
    "source_unchanged": {"const": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "image", "image_sha256", "width", "height", "native_text", "native_text_sha256", "native_text_characters"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "image": {"type": "string", "pattern": "^pages/page-[1-9][0-9]*[.]png$"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "native_text": {"type": "string", "pattern": "^native-text/page-[1-9][0-9]*[.]txt$"},
        "native_text_sha256": {"$ref": "#/$defs/sha256"},
        "native_text_characters": {"type": "integer", "minimum": 0}
      }
    }
  }
}
