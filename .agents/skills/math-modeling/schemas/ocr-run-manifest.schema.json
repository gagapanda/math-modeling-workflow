{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/math-modeling/ocr-run-manifest.schema.json",
  "title": "Hash-bound selected-page OCR run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "completed_at", "source_manifest", "engine", "configuration", "pages", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "completed"},
    "completed_at": {"type": "string", "minLength": 1},
    "source_manifest": {"$ref": "#/$defs/binding"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "language", "model", "model_sha256", "auxiliary_models", "tessdata_dir", "oem", "psm"],
      "properties": {
        "backend": {"const": "tesseract"},
        "language": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "model": {"type": "string", "minLength": 1},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "auxiliary_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "tessdata_dir": {"type": "string", "minLength": 1},
        "oem": {"type": "integer", "minimum": 0, "maximum": 3},
        "psm": {"type": "integer", "minimum": 0, "maximum": 13}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "image", "image_sha256", "text", "text_sha256", "text_characters", "stderr"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "image": {"type": "string", "minLength": 1},
          "image_sha256": {"$ref": "#/$defs/sha256"},
          "text": {"type": "string", "pattern": "^page-[1-9][0-9]*[.]txt$"},
          "text_sha256": {"$ref": "#/$defs/sha256"},
          "text_characters": {"type": "integer", "minimum": 0},
          "stderr": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
